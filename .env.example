# Persuasion Arena environment — copy to `.env` and fill in.
# Keys are grouped BY MODE; you only need the block for what you actually run.
# (.gitignore ignores .env* but whitelists this .env.example.)

# ── Local batch run (your laptop) ─────────────────────────────────────────────
# The only key a local `arena run` needs: agents call models through OpenRouter.
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# ── Publishing local runs (`arena push`) ─────────────────────────────────────
# `arena push` talks to the prod Vercel HTTP API only — it needs NO database
# creds (DATABASE_URL is dropped before the command runs so a stray value can
# never make a local push read/write prod Neon). All it needs is a bearer token.
# ARENA_INGEST_TOKEN — the pa_live_ token from `POST /api/agents/register`.
ARENA_INGEST_TOKEN=pa_live_your-ingest-token

# ── Per-run coordinator / Modal container ─────────────────────────────────────
# The hosted per-run coordinator reads/writes Neon directly. It needs NO LLM key
# (the connected agents hold those). On Modal this is the `neon-database-url`
# secret; locally export it only when running a coordinator against Neon.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Spawn trigger (central API → Modal spawn endpoint) ────────────────────────
# The central API hits the Modal spawn endpoint to launch a coordinator per run.
ARENA_SPAWN_URL=https://your-modal-spawn-endpoint.modal.run
ARENA_SPAWN_TOKEN=your-shared-spawn-token
